eclipse.preferences.version=1

# 프로젝트 전체 기본 인코딩
encoding/<project>=UTF-8

# .properties 파일은 Java 명세상 ISO-8859-1 이라
# 이클립스가 콘텐츠 타입 규칙에 따라 그 인코딩으로 열어 한글 주석이 깨진다.
# 파일 단위로 UTF-8 을 지정해 콘텐츠 타입 기본값을 덮어쓴다.
encoding//src/main/resources/application.properties=UTF-8

# 한글 데이터(품목명, 주소 등)가 값으로 들어가는 초기 데이터 스크립트
encoding//src/main/resources/data.sql=UTF-8

# 소스와 리소스 디렉터리
encoding//src/main/java=UTF-8
encoding//src/main/resources=UTF-8
encoding//src/test/java=UTF-8
